[jira]
client_id = "ADD_ORGANIZATION_REGISTERED_OAUTH_CLIENT_ID"
client_secret = "ADD_ORGANIZATION_REGISTERED_OAUTH_CLIENT_SECRET"
redirect_uri = "http://localhost:8501/"
site_url = "https://vishala-ai.atlassian.net"
project_key = "KAN"
team_field = "customfield_10001"

# Optional: use a dedicated Atlassian OAuth 2.0 app for Jira simulation writes.
# Configure the Jira API classic scopes read:jira-work and write:jira-work.
# The job requests offline_access in its OAuth flow to receive a refresh token.
[jira_simulation]
client_id = "ADD_DEDICATED_SIMULATION_OAUTH_CLIENT_ID"
client_secret = "ADD_DEDICATED_SIMULATION_OAUTH_CLIENT_SECRET"
project_key = "KAN"
redirect_uri = "http://localhost:8765/callback"
random_seed = 20261009

# Local Ollama commentary is the default and needs no API key.
[ai]
provider = "ollama"
model = "llama3.2"
base_url = "http://localhost:11434"

# Optional: set [ai].provider = "openai" to use this provider instead.
[openai]
api_key = "ADD_YOUR_OPENAI_API_KEY_LOCALLY"
model = "gpt-6-luna"
